# Environment Variables — ArchStandards
# Copy this file to .env and fill in the values

# GitHub App Configuration
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Optional: Database (Phase 9)
# DATABASE_URL=postgresql://user:pass@localhost:5432/archstandards

# Optional: Redis (Phase 9)
# REDIS_URL=redis://localhost:6379
